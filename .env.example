# gpss-in-a-box config
# Copy to .env and adjust for your machine

# Set to 1 to run legality checks only (no full PKHeX build)
LEGALITY_ONLY=0

# Host port for the web UI (the container continues listening on 8082)
VIEWER_PORT=8082

# Your LAN IP — shown in startup output so you can copy the URL
# Leave blank to skip LAN URL display
HOST_IP=
